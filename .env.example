# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/

# OpenAI
OPENAI_API_KEY=sk-proj-your_key_here
AI_MODEL=gpt-4o-mini
MATCH_THRESHOLD=7.0

# Web UI Authentication (required for web access)
# Username for login (single user)
TRACKER_USERNAME=your_username

# Password hash (generate with: python scripts/generate_password_hash.py)
# Example hash below is for password "changeme" - CHANGE THIS!
TRACKER_PASSWORD_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LEqT6VDxHxPJ2BT/m

# Flask secret key (optional - auto-generated if not set)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ALLOWED_USER_ID=your_user_id
TELEGRAM_CHAT_ID=your_chat_id
TELEGRAM_MESSAGE_THREAD_ID=your_thread_id

# Bearer token for POST /api/agent/jobs (Claude daily job push)
AGENT_API_TOKEN=
